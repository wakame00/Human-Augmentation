-- rocket.lua
-- GPS waypoint guidance

local POWER = 1.0
local UPDATE_INTERVAL = 0.05
local ARRIVAL_RADIUS = 4
local GPS_TIMEOUT = 3

local controller
local controllerName

for _, name in ipairs(peripheral.getNames()) do
    local p = peripheral.wrap(name)

    if p and p.getVector and p.setTargetVector then
        controller = p
        controllerName = name
        break
    end
end

if not controller then
    print("No flight controller found")
    print("Visible peripherals:")

    for _, name in ipairs(peripheral.getNames()) do
        print("- " .. name .. " (" .. tostring(peripheral.getType(name)) .. ")")
    end

    error("Connect computer directly to controller")
end

if not controller then
    error("Controller not found: " .. CONTROLLER_SIDE)
end

if not controller.getVector then
    error("getVector missing")
end

if not controller.setTargetVector then
    error("setTargetVector missing")
end

if not controller.setPowerNormalized and not controller.setThrustNormalized
    and not controller.setThrust then
    error("Power method missing")
end

local function setPower(value)
    value = math.max(0, math.min(1, value))

    if controller.setPowerNormalized then
        controller.setPowerNormalized(value)
    elseif controller.setThrustNormalized then
        controller.setThrustNormalized(value)
    else
        controller.setThrust(value)
    end
end

local function setTarget(x, y, z)
    -- Most controllers use 3 numeric arguments.
    local ok, err = pcall(function()
        controller.setTargetVector(x, y, z)
    end)

    if not ok then
        -- Fallback for controllers expecting a vector table.
        local okTable, tableErr = pcall(function()
            controller.setTargetVector({
                x = x,
                y = y,
                z = z
            })
        end)

        if not okTable then
            error("Target error: " .. tostring(err or tableErr))
        end
    end
end

local function length(x, y, z)
    return math.sqrt(x * x + y * y + z * z)
end

local function readTarget()
    while true do
        write("Target X Y Z: ")

        local input = read()
        local x, y, z = input:match(
            "^%s*(-?[%d%.]+)%s+(-?[%d%.]+)%s+(-?[%d%.]+)%s*$"
        )

        x, y, z = tonumber(x), tonumber(y), tonumber(z)

        if x and y and z then
            return x, y, z
        end

        print("Format: X Y Z")
        print("Example: 58 63 18")
    end
end

local function getPosition()
    local x, y, z = gps.locate(GPS_TIMEOUT, false)

    if not x then
        return nil
    end

    return x, y, z
end

print("Controller: " .. CONTROLLER_SIDE)

local ok, currentVector = pcall(function()
    return controller.getVector()
end)

if ok then
    print("Vector: " .. textutils.serialise(currentVector))
end

local targetX, targetY, targetZ = readTarget()

print(("Target: %.1f %.1f %.1f"):format(
    targetX, targetY, targetZ
))

write("Launch? y/n: ")

if read():lower() ~= "y" then
    print("Cancelled")
    return
end

setPower(POWER)
print("Launched")

while true do
    local x, y, z = getPosition()

    if not x then
        setPower(0)
        error("GPS lost - stopped")
    end

    local dx = targetX - x
    local dy = targetY - y
    local dz = targetZ - z
    local distance = length(dx, dy, dz)

    if distance <= ARRIVAL_RADIUS then
        setPower(0)
        print("Arrived - stopped")
        break
    end

    -- Direction from current GPS location to target
    setTarget(dx / distance, dy / distance, dz / distance)

    term.setCursorPos(1, 8)
    term.clearLine()
    write(("GPS: %.1f %.1f %.1f"):format(x, y, z))

    term.setCursorPos(1, 9)
    term.clearLine()
    write(("Distance: %.1f"):format(distance))

    os.sleep(UPDATE_INTERVAL)
end
