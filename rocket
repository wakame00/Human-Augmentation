-- missile.lua
-- Four vector thrusters + GPS takeoff and cruise guidance

local thrusters = {
    "back",
    "front",
    "right",
    "left"
}

local MAX_POWER = 0.12
local MAX_SPEED = 8
local TAKEOFF_HEIGHT = 80
local TAKEOFF_SPEED = 4

local UPDATE_INTERVAL = 0.15
local ARRIVAL_RADIUS = 5
local STOP_SPEED = 0.8

-- Set to -1 only if thrust direction is reversed.
local THRUST_SIGN = 1

local function clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

local function length(x, y, z)
    return math.sqrt(x * x + y * y + z * z)
end

local function stopAll()
    for _, name in ipairs(thrusters) do
        pcall(peripheral.call, name, "setPowerNormalized", 0)
    end
end

local function setThrust(x, y, z, power)
    for _, name in ipairs(thrusters) do
        local ok, err = pcall(
            peripheral.call,
            name,
            "setVector",
            x * THRUST_SIGN,
            y * THRUST_SIGN,
            z * THRUST_SIGN
        )

        if not ok then
            stopAll()
            error("Vector error on " .. name .. ": " .. tostring(err))
        end

        local powerOk, powerErr = pcall(
            peripheral.call,
            name,
            "setPowerNormalized",
            power
        )

        if not powerOk then
            stopAll()
            error("Power error on " .. name .. ": " .. tostring(powerErr))
        end
    end
end

local function readTarget()
    while true do
        write("Target X Y Z: ")

        local input = read()
        local x, y, z = input:match(
            "^%s*(-?[%d%.]+)%s+(-?[%d%.]+)%s+(-?[%d%.]+)%s*$"
        )

        x = tonumber(x)
        y = tonumber(y)
        z = tonumber(z)

        if x and y and z then
            return x, y, z
        end

        print("Format: X Y Z")
        print("Example: 62 50 -107")
    end
end

for _, name in ipairs(thrusters) do
    if not peripheral.isPresent(name) then
        error("Thruster not found: " .. name)
    end
end

print("Thrusters: " .. #thrusters)

local targetX, targetY, targetZ = readTarget()

print(("Target: %.1f %.1f %.1f"):format(
    targetX,
    targetY,
    targetZ
))

local _, launchY = gps.locate(3, false)

if not launchY then
    error("GPS unavailable")
end

local takeoffY = launchY + TAKEOFF_HEIGHT

print("Takeoff Y: " .. math.floor(takeoffY))

write("Launch? y/n: ")

if read():lower() ~= "y" then
    print("Cancelled")
    return
end

local phase = "takeoff"
local previousX, previousY, previousZ
local previousTime

print("Launched")

while true do
    local x, y, z = gps.locate(3, false)

    if not x then
        stopAll()
        error("GPS lost - stopped")
    end

    local now = os.epoch("utc")
    local velocityX, velocityY, velocityZ = 0, 0, 0

    if previousTime then
        local deltaTime = (now - previousTime) / 1000

        if deltaTime > 0 then
            velocityX = (x - previousX) / deltaTime
            velocityY = (y - previousY) / deltaTime
            velocityZ = (z - previousZ) / deltaTime
        end
    end

    previousX = x
    previousY = y
    previousZ = z
    previousTime = now

    local dx = targetX - x
    local dy = targetY - y
    local dz = targetZ - z
    local distance = length(dx, dy, dz)
    local speed = length(velocityX, velocityY, velocityZ)

    local desiredVX, desiredVY, desiredVZ

    if phase == "takeoff" then
        -- Vertical ascent and braking at the selected height.
        local altitudeError = takeoffY - y

        desiredVX = 0
        desiredVZ = 0
        desiredVY = clamp(
            altitudeError * 0.5,
            -TAKEOFF_SPEED,
            TAKEOFF_SPEED
        )

        if math.abs(altitudeError) <= 3
            and math.abs(velocityY) <= STOP_SPEED then
            phase = "cruise"
            print("Cruise phase")
        end
    else
        -- Cruise speed automatically decreases close to target.
        if distance > 0.01 then
            local desiredSpeed = math.min(MAX_SPEED, distance * 0.5)

            desiredVX = (dx / distance) * desiredSpeed
            desiredVY = (dy / distance) * desiredSpeed
            desiredVZ = (dz / distance) * desiredSpeed
        else
            desiredVX = 0
            desiredVY = 0
            desiredVZ = 0
        end

        if distance <= ARRIVAL_RADIUS and speed <= STOP_SPEED then
            stopAll()
            print("Arrived - stopped")
            break
        end
    end

    -- Velocity correction: accelerates, brakes, and counters drift.
    local correctionX = desiredVX - velocityX
    local correctionY = desiredVY - velocityY
    local correctionZ = desiredVZ - velocityZ
    local correctionLength = length(
        correctionX,
        correctionY,
        correctionZ
    )

    if correctionLength > 0.01 then
        local power = clamp(
            (correctionLength / MAX_SPEED) * MAX_POWER,
            0,
            MAX_POWER
        )

        setThrust(
            correctionX / correctionLength,
            correctionY / correctionLength,
            correctionZ / correctionLength,
            power
        )
    else
        stopAll()
    end

    term.setCursorPos(1, 8)
    term.clearLine()
    write("Phase: " .. phase)

    term.setCursorPos(1, 9)
    term.clearLine()
    write(("Distance: %.1f"):format(distance))

    term.setCursorPos(1, 10)
    term.clearLine()
    write(("Speed: %.1f"):format(speed))

    os.sleep(UPDATE_INTERVAL)
end
