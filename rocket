-- missile.lua
-- Four vector thrusters + GPS guidance

local POWER = 1.0
local UPDATE_INTERVAL = 0.05
local ARRIVAL_RADIUS = 4
local GPS_TIMEOUT = 3

-- If the missile flies away from the target, change this to -1.
local THRUST_SIGN = 1

local thrusters = {
    "back",
    "front",
    "right",
    "left"
}

for _, name in ipairs(thrusters) do
    if not peripheral.isPresent(name) then
        error("Thruster not found: " .. name)
    end
end

print("Thrusters found: " .. #thrusters)

for _, name in ipairs(thrusters) do
    print("- " .. name)
end

print("Thrusters found: " .. #thrusters)

for _, name in ipairs(thrusters) do
    print("- " .. name)
end

local function stopAll()
    for _, name in ipairs(thrusters) do
        pcall(function()
            peripheral.call(name, "setPowerNormalized", 0)
        end)
    end
end

local function setPower(value)
    value = math.max(0, math.min(1, value))

    for _, name in ipairs(thrusters) do
        local ok, err = pcall(function()
            peripheral.call(name, "setPowerNormalized", value)
        end)

        if not ok then
            stopAll()
            error("Power error on " .. name .. ": " .. tostring(err))
        end
    end
end

local function setDirection(x, y, z)
    for _, name in ipairs(thrusters) do
        local ok, err = pcall(function()
            peripheral.call(name, "setVector", x, y, z)
        end)

        -- Fallback if this mod expects a vector table.
        if not ok then
            ok, err = pcall(function()
                peripheral.call(name, "setVector", {
                    x = x,
                    y = y,
                    z = z
                })
            end)
        end

        if not ok then
            stopAll()
            error("Vector error on " .. name .. ": " .. tostring(err))
        end
    end
end

local function length(x, y, z)
    return math.sqrt(x * x + y * y + z * z)
end

local function readTarget()
    while true do
        write("Target X Y Z: ")

        local input = read()
        local x, y, z = input:match(
            "^%s*(-?[%d%.]+)%s+(-?[%d%.]+)%s+(-?[%d%.]+)%s*$"
        )

        x = tonumber(x)
        y = tonumber(y)
        z = tonumber(z)

        if x and y and z then
            return x, y, z
        end

        print("Format: X Y Z")
        print("Example: 58 63 18")
    end
end

local function getPosition()
    return gps.locate(GPS_TIMEOUT, false)
end

local targetX, targetY, targetZ = readTarget()

print(("Target: %.1f %.1f %.1f"):format(
    targetX, targetY, targetZ
))

write("Launch? y/n: ")

if read():lower() ~= "y" then
    print("Cancelled")
    return
end

setPower(POWER)
print("Launched")

while true do
    local x, y, z = getPosition()

    if not x then
        stopAll()
        error("GPS lost - stopped")
    end

    local dx = targetX - x
    local dy = targetY - y
    local dz = targetZ - z
    local distance = length(dx, dy, dz)

    if distance <= ARRIVAL_RADIUS then
        stopAll()
        print("Arrived - stopped")
        break
    end

    local nx = (dx / distance) * THRUST_SIGN
    local ny = (dy / distance) * THRUST_SIGN
    local nz = (dz / distance) * THRUST_SIGN

    setDirection(nx, ny, nz)

    term.setCursorPos(1, 9)
    term.clearLine()
    write(("GPS: %.1f %.1f %.1f"):format(x, y, z))

    term.setCursorPos(1, 10)
    term.clearLine()
    write(("Distance: %.1f"):format(distance))

    os.sleep(UPDATE_INTERVAL)
end
