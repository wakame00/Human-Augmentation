-- missile.lua
-- GPS guidance with speed control

local thrusters = {"back", "front", "right", "left"}

local MAX_POWER = 0.12       -- Start low. Raise slowly: 0.15, 0.20...
local MAX_SPEED = 8          -- blocks per second
local UPDATE_INTERVAL = 0.15
local ARRIVAL_RADIUS = 5
local STOP_SPEED = 0.8
local THRUST_SIGN = 1        -- Change to -1 if direction is reversed

local function clamp(value, minValue, maxValue)
    return math.max(minValue, math.min(maxValue, value))
end

local function length(x, y, z)
    return math.sqrt(x * x + y * y + z * z)
end

local function stopAll()
    for _, name in ipairs(thrusters) do
        pcall(peripheral.call, name, "setPowerNormalized", 0)
    end
end

local function setThrust(vectorX, vectorY, vectorZ, power)
    for _, name in ipairs(thrusters) do
        local ok, err = pcall(
            peripheral.call,
            name,
            "setVector",
            vectorX * THRUST_SIGN,
            vectorY * THRUST_SIGN,
            vectorZ * THRUST_SIGN
        )

        if not ok then
            stopAll()
            error("Vector error on " .. name .. ": " .. tostring(err))
        end

        peripheral.call(name, "setPowerNormalized", power)
    end
end

local function readTarget()
    while true do
        write("Target X Y Z: ")

        local input = read()
        local x, y, z = input:match(
            "^%s*(-?[%d%.]+)%s+(-?[%d%.]+)%s+(-?[%d%.]+)%s*$"
        )

        x, y, z = tonumber(x), tonumber(y), tonumber(z)

        if x and y and z then
            return x, y, z
        end

        print("Format: X Y Z")
    end
end

for _, name in ipairs(thrusters) do
    if not peripheral.isPresent(name) then
        error("Thruster not found: " .. name)
    end
end

local targetX, targetY, targetZ = readTarget()

print(("Target: %.1f %.1f %.1f"):format(
    targetX, targetY, targetZ
))

write("Launch? y/n: ")

if read():lower() ~= "y" then
    return
end

local previousX, previousY, previousZ
local previousTime

while true do
    local x, y, z = gps.locate(3, false)

    if not x then
        stopAll()
        error("GPS lost")
    end

    local now = os.epoch("utc")
    local velocityX, velocityY, velocityZ = 0, 0, 0

    if previousTime then
        local deltaTime = (now - previousTime) / 1000

        if deltaTime > 0 then
            velocityX = (x - previousX) / deltaTime
            velocityY = (y - previousY) / deltaTime
            velocityZ = (z - previousZ) / deltaTime
        end
    end

    previousX, previousY, previousZ = x, y, z
    previousTime = now

    local dx = targetX - x
    local dy = targetY - y
    local dz = targetZ - z
    local distance = length(dx, dy, dz)
    local currentSpeed = length(velocityX, velocityY, velocityZ)

    -- Desired speed decreases near the target.
    local desiredSpeed = math.min(MAX_SPEED, distance * 0.5)

    local desiredVX = (dx / distance) * desiredSpeed
    local desiredVY = (dy / distance) * desiredSpeed
    local desiredVZ = (dz / distance) * desiredSpeed

    -- Accelerate toward desired velocity; reverses thrust to brake.
    local correctionX = desiredVX - velocityX
    local correctionY = desiredVY - velocityY
    local correctionZ = desiredVZ - velocityZ
    local correctionLength = length(correctionX, correctionY, correctionZ)

    if distance <= ARRIVAL_RADIUS and currentSpeed <= STOP_SPEED then
        stopAll()
        print("Arrived - stopped")
        break
    end

    if correctionLength > 0.01 then
        local power = clamp(
            (correctionLength / MAX_SPEED) * MAX_POWER,
            0,
            MAX_POWER
        )

        setThrust(
            correctionX / correctionLength,
            correctionY / correctionLength,
            correctionZ / correctionLength,
            power
        )
    else
        stopAll()
    end

    term.setCursorPos(1, 8)
    term.clearLine()
    write(("Distance: %.1f"):format(distance))

    term.setCursorPos(1, 9)
    term.clearLine()
    write(("Speed: %.1f"):format(currentSpeed))

    os.sleep(UPDATE_INTERVAL)
end
